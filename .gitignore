# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log

# Build artifacts
/dist/
/build/
/bin/

# Coverage reports
coverage.out
coverage.html

# Profiling data
*.prof
*.pprof

# Air live reload
tmp/

# Local environment files
.env
.env.local
.env.*.local

# Documentation build artifacts
/docs/_build/

# Example outputs (if any)
/examples/*/output/
/examples/*/logs/

# Example binaries. `go build` in an example directory emits a binary named
# after that directory, so they are listed explicitly rather than by a pattern
# that would also swallow the source directories themselves.
/examples/basic/basic
/examples/enhanced-errors/enhanced-errors
/examples/filemanager/filemanager
/examples/gitlike/gitlike
/examples/observability/observability
/examples/security-validation/security-validation
/examples/storage/storage
/examples/storage-simple/storage-simple
/examples/storage/plugins/*.so

# Demo and recording files
*.cast
demo-script.sh
RECORDING.md
